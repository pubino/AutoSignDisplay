<?xml version="1.0" encoding="UTF-8"?>
<!--
  AutoSignDisplay — Managed App Configuration (typical unattended display)

  The smallest payload that produces a locked-down kiosk: one channel, plays on
  launch, recovers from network drops, on-device settings disabled.

  Replace the URL, then paste into your MDM's app-configuration field for
  edu.princeton.autosigndisplay.
-->
<plist version="1.0">
<dict>
  <key>DisplayTitle</key>
  <string>Engineering Quad — Lobby</string>

  <key>PlayOnAppOpen</key>
  <true/>

  <key>AutoResume</key>
  <true/>

  <!-- Disables the Settings link outright. Note what this does to SettingsPIN, below. -->
  <key>SettingsDisabled</key>
  <true/>

  <!-- Reduces the screen to the preset list. On its own it leaves Settings reachable, so
       the mode can be switched off from the device; SettingsDisabled above removes that.
       Drop ViewOnlyMode if a local user should be able to enter URLs. -->
  <key>ViewOnlyMode</key>
  <true/>

  <!-- SettingsPIN is deliberately NOT set here, and setting it would do nothing: the PIN
       prompt lives inside the Settings screen, which SettingsDisabled makes unreachable.
       For a PIN-gated display that a technician can still get into, drop SettingsDisabled
       and set SettingsPIN instead. -->

  <key>RetryTimeout</key>
  <real>5.0</real>

  <key>ChannelPresets</key>
  <array>
    <dict>
      <key>Name</key>
      <string>Lobby</string>
      <key>URL</key>
      <string>https://stream.example.edu/lobby/index.m3u8</string>
    </dict>
  </array>

  <key>DefaultChannel</key>
  <string>https://stream.example.edu/lobby/index.m3u8</string>
</dict>
</plist>
